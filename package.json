{
  "name": "loom",
  "version": "0.1.0",
  "private": true,
  "description": "Loom: git for agents. Many coding agents share one repository without stepping on each other. Built on Cloudflare Workers, Artifacts, Durable Objects and R2.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --env local",
    "shim": "node shim/artifacts-shim.mjs",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "demo": "node demo/swarm.mjs",
    "demo:claude": "node demo/claude-swarm.mjs",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "phone-check": "node scripts/phone-check.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.13",
    "isomorphic-git": "^1.43.0",
    "node-diff3": "^3.2.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
